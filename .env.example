PORT=3001
MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp
MCP_TOKEN=your_mcp_token_here
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com
TEAM_KEY=your_team_key_here

# Enable the live proxy on authenticated plan imports and invitation journeys.
ADVISOR_PLAN_AI=false
ADVISOR_INTERVIEW_AI=false
ADVISOR_QUESTIONS_AI=false
ADVISOR_TTS=false

# Server-side narration uses the Sherpas proxy by default. To use ElevenLabs
# directly, configure TTS_PROVIDER=elevenlabs and ELEVENLABS_API_KEY as well.
TTS_PROVIDER=proxy
TTS_VOICE_ID=
OPENROUTER_TTS_MODEL=
# ELEVENLABS_API_KEY=
# TTS_MODEL=eleven_flash_v2_5
# AUDIT_INVITE_SIGNING_KEY=

OPENROUTER_PRIMARY_MODEL=gpt-5-mini
OPENROUTER_FAST_MODEL=gemini-3.5-flash-lite
OPENROUTER_ANALYSIS_MODEL=gpt-5-mini
OPENROUTER_REALTIME_MODEL=gpt-realtime-2.1-mini

# Advisor workspace (Supabase). Apply every file in supabase/migrations in order.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# AUDIT_INVITE_SIGNING_KEY=
# Require this code to create an advisor account (leave empty for open sign-up).
ADVISOR_SIGNUP_CODE=
# Shared demo workspace for judges ("Explore the demo workspace").
DEMO_ADVISOR_EMAIL=
DEMO_ADVISOR_PASSWORD=

# Invitation and check-in emails (Resend). Without a key, messages open in the advisor's email app.
RESEND_API_KEY=
EMAIL_FROM=The Plan Audit <onboarding@resend.dev>
# Public address used in reminder links (Render sets RENDER_EXTERNAL_URL automatically).
PUBLIC_URL=
# Protects POST /api/cron/reminders (called daily by .github/workflows/reminders.yml).
CRON_SECRET=
